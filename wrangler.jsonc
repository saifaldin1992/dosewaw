// DOSEWAW on Cloudflare Workers. Deployed by Workers Builds from GitHub:
// branch "main" -> production (LIVE database), any other branch -> preview (TEST database).
{
  "name": "dosewaw",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // only these run the worker; every other request is a free static asset
    "run_worker_first": ["/data/*", "/js/config.js"]
  },
  // public values only (the anon key is meant to be public; the data is protected by row security)
  "vars": {
    "SUPABASE_URL": "https://kryoddbkwljbpjhhwhut.supabase.co",
    "SUPABASE_ANON_KEY": "PASTE_LIVE_ANON_KEY",
    "TEST_SUPABASE_URL": "https://oqynswsbhtgnnuyjwrea.supabase.co",
    "TEST_SUPABASE_ANON_KEY": "PASTE_TEST_ANON_KEY"
  },
  "triggers": { "crons": ["23 3 * * *"] },
  "observability": { "enabled": true },
  // previews use the test project «dosewaw-test», so a preview never touches the live site
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://oqynswsbhtgnnuyjwrea.supabase.co",
      "SUPABASE_ANON_KEY": "PASTE_TEST_ANON_KEY",
      "IS_TEST": "1"
    }
  }
}
